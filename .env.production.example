APP_NAME="Dự Đoán Lá"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN_HERE
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_LEVEL=error

# ===================== DATABASE =====================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=du_doan_la
DB_USERNAME=du_doan_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# ===================== CACHE / QUEUE / SESSION =====================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_PASSWORD_HERE

# ===================== MAIL =====================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=MAIL_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Dự Đoán Lá"
BACKUP_NOTIFICATION_EMAIL=admin@example.com

# ===================== FILAMENT =====================
FILAMENT_FILESYSTEM_DISK=local

# ===================== BACKUP =====================
BACKUP_ARCHIVE_PASSWORD=STRONG_BACKUP_PASSWORD_HERE

# ===================== SECURITY =====================
# Không bao giờ commit key thật. Dùng vault/secrets manager.
# SESSION_COOKIE phải unique per app
SESSION_COOKIE=du_doan_la_session
